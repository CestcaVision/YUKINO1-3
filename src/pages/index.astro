---
import { sitePath } from "../site-path";
import MobiusSurface from "../components/MobiusSurface";
import HalftoneHero from "../components/HalftoneHero";
import BezierStudy from "../components/BezierStudy.astro";
import LorenzTrace from "../components/LorenzTrace.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const works = await getCollection(
  "works",
  ({ data }) => data.lifecycle === "published",
);
const notes = await getCollection(
  "notes",
  ({ data }) => data.lifecycle === "published",
);
const milestones = await getCollection(
  "milestones",
  ({ data }) => data.lifecycle === "published",
);
const evidence = [
  ...works.map(({ data }) => ({
    ...data,
    kind: "Work",
    href: `/works/${data.slug}/`,
  })),
  ...notes.map(({ data }) => ({
    ...data,
    kind: "Note",
    href: `/notes/${data.slug}/`,
  })),
].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf() || a.href.localeCompare(b.href),
);
// Feature the most recently published Work; no inferred claim of quality or ranking.
const featuredWork = evidence.find((item) => item.kind === "Work");
const latestNote = evidence.find((item) => item.kind === "Note");
// Replace this file with your own image, or change this path. Keep it local
// so the hero works without a third-party image host or CORS permissions.
const heroImage = sitePath("/images/hero-halftone.png");
const activity = [
  ...evidence,
  ...milestones.map(({ id, data }) => ({
    ...data,
    kind: "Milestone",
    href: "",
    id,
  })),
].sort(
  (a, b) =>
    b.date.valueOf() - a.date.valueOf() ||
    a.title.localeCompare(b.title) ||
    a.kind.localeCompare(b.kind),
);
---

<BaseLayout
  title="Home"
  description="A personal collection of things I’m learning and making: notes, small experiments, and projects in mathematics and computing."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Hi, I’m <span>Yukino.</span>
      </h1>
      <p class="hero-introduction">
        A place for things I’m learning and making.
      </p>
      <p class="hero-description">
        This is where I keep notes from what I’m learning, share things I’ve
        made, and follow questions that catch my attention. Most of them start
        with maths or code; sometimes the interesting part is where they lead.
      </p>
      <div class="hero-actions">
        <a class="hero-primary-link" href="#featured-work">
          Explore my work
        </a>
        <a href={sitePath("/about/")}>More about me</a>
      </div>
    </div>
    <HalftoneHero
      client:load
      src={heroImage}
      alt="Blue-haired character illustration from the Halftone Reveal demo"
      fit="contain"
      inkColor="#0d0d0d"
      cellSize={6}
      revealRadius={160}
    />
  </section>

  <section class="works-showcase" aria-labelledby="featured-work">
    <div class="works-showcase-copy">
      <h2 id="featured-work">Something I’ve made</h2>
      <p class="works-introduction">
        Small experiments in maths and code. A place to try an idea, turn it
        around, and see where it leads.
      </p>
      <div class="home-evidence">
        {featuredWork ? (
          <article>
            <p class="note-meta">{featuredWork.subject}</p>
            <h3>
              <a href={sitePath(featuredWork.href)}>{featuredWork.title}</a>
            </h3>
            <p>{featuredWork.summary}</p>
          </article>
        ) : (
          <p>I’ll share my first project here when it’s ready.</p>
        )}
        <a href={sitePath("/works/")}>See all my work</a>
      </div>
    </div>
    <div class="works-showcase-visual">
      <MobiusSurface client:visible />
    </div>
  </section>

  <section
    class="evidence-section notebook-section"
    aria-labelledby="latest-note"
  >
    <div class="section-art-column">
      <h2 id="latest-note">From my notebook</h2>
      <BezierStudy />
    </div>
    <div class="home-evidence">
      {latestNote ? (
        <article>
          <p class="note-meta">{latestNote.subject}</p>
          <h3>
            <a href={sitePath(latestNote.href)}>{latestNote.title}</a>
          </h3>
          <p>{latestNote.summary}</p>
        </article>
      ) : (
        <p>I’m still putting my first notes together. More soon.</p>
      )}
      <a href={sitePath("/notes/")}>Read all notes</a>
    </div>
  </section>

  <section class="activity-section" aria-labelledby="activity-title">
    <div class="section-art-column">
      <h2 id="activity-title">Lately</h2>
      <LorenzTrace items={activity} />
    </div>
    {activity.length > 0 ? (
      <ol class="activity-list">
        {activity.map((item, index) => (
          <li
            id={`recent-activity-${index}`}
            data-activity-entry={index}
            tabindex="-1"
          >
            <div class="note-meta">
              <time datetime={item.date.toISOString()}>
                {item.date.toLocaleDateString("en-GB", {
                  dateStyle: "long",
                  timeZone: "UTC",
                })}
              </time>
              <span>{item.kind === "Milestone" ? "Update" : item.kind}</span>
            </div>
            <h3>
              {item.href ? (
                <a href={sitePath(item.href)}>{item.title}</a>
              ) : (
                item.title
              )}
            </h3>
            <p>{item.summary}</p>
          </li>
        ))}
      </ol>
    ) : (
      <p>
        New projects, notes, and little discoveries will find their way here.
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .section-art-column {
    min-width: 0;
  }
  .notebook-section .home-evidence {
    align-self: center;
  }
  .home-evidence h3,
  .activity-list h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    margin: 1rem 0;
  }
  .home-evidence p,
  .activity-list p {
    line-height: 1.65;
  }
  .activity-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .activity-list li + li {
    border-top: 1px solid var(--color-line);
    margin-top: 2rem;
    padding-top: 2rem;
  }
  .note-meta {
    flex-wrap: wrap;
  }
</style>
