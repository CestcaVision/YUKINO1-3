---
import MobiusSurface from "../components/MobiusSurface";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const works = await getCollection(
  "works",
  ({ data }) => data.lifecycle === "published",
);
const notes = await getCollection(
  "notes",
  ({ data }) => data.lifecycle === "published",
);
const milestones = await getCollection(
  "milestones",
  ({ data }) => data.lifecycle === "published",
);
const evidence = [
  ...works.map(({ data }) => ({
    ...data,
    kind: "Work",
    href: `/works/${data.slug}/`,
  })),
  ...notes.map(({ data }) => ({
    ...data,
    kind: "Note",
    href: `/notes/${data.slug}/`,
  })),
].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf() || a.href.localeCompare(b.href),
);
// Feature the most recently published Work; no inferred claim of quality or ranking.
const featuredWork = evidence.find((item) => item.kind === "Work");
const latestNote = evidence.find((item) => item.kind === "Note");
const activity = [
  ...evidence,
  ...milestones.map(({ id, data }) => ({
    ...data,
    kind: "Milestone",
    href: "",
    id,
  })),
].sort(
  (a, b) =>
    b.date.valueOf() - a.date.valueOf() ||
    a.title.localeCompare(b.title) ||
    a.kind.localeCompare(b.kind),
);
---

<BaseLayout
  title="Home"
  description="A personal collection of things I’m learning and making: notes, small experiments, and projects in mathematics and computing."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">A place for things I’m learning and making.</h1>
      <p>
        This is where I keep notes from what I’m learning, share things I’ve
        made, and follow questions that catch my attention. Most of them start
        with maths or code; sometimes the interesting part is where they lead.
      </p>
    </div>
    <div class="hero-plot">
      <MobiusSurface client:visible />
    </div>
  </section>

  {[
    {
      id: "featured-work",
      title: "Something I’ve made",
      item: featuredWork,
      href: "/works/",
      link: "See all my work",
      empty: "I’ll share my first project here when it’s ready.",
    },
    {
      id: "latest-note",
      title: "From my notebook",
      item: latestNote,
      href: "/notes/",
      link: "Read all notes",
      empty: "I’m still putting my first notes together. More soon.",
    },
  ].map(({ id, title, item, href, link, empty }) => (
    <section class="evidence-section" aria-labelledby={id}>
      <h2 id={id}>{title}</h2>
      <div class="home-evidence">
        {item ? (
          <article>
            <p class="note-meta">{item.subject}</p>
            <h3>
              <a href={item.href}>{item.title}</a>
            </h3>
            <p>{item.summary}</p>
          </article>
        ) : (
          <p>{empty}</p>
        )}
        <a href={href}>{link}</a>
      </div>
    </section>
  ))}

  <section class="activity-section" aria-labelledby="activity-title">
    <h2 id="activity-title">Lately</h2>
    {activity.length > 0 ? (
      <ol class="activity-list">
        {activity.map((item) => (
          <li>
            <div class="note-meta">
              <time datetime={item.date.toISOString()}>
                {item.date.toLocaleDateString("en-GB", {
                  dateStyle: "long",
                  timeZone: "UTC",
                })}
              </time>
              <span>{item.kind === "Milestone" ? "Update" : item.kind}</span>
            </div>
            <h3>
              {item.href ? <a href={item.href}>{item.title}</a> : item.title}
            </h3>
            <p>{item.summary}</p>
          </li>
        ))}
      </ol>
    ) : (
      <p>
        New projects, notes, and little discoveries will find their way here.
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .home-evidence h3,
  .activity-list h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    margin: 1rem 0;
  }
  .home-evidence p,
  .activity-list p {
    line-height: 1.65;
  }
  .activity-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .activity-list li + li {
    border-top: 1px solid var(--color-line);
    margin-top: 2rem;
    padding-top: 2rem;
  }
  .note-meta {
    flex-wrap: wrap;
  }
</style>
