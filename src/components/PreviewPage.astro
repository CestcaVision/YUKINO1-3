---
import PlotMotif from "./PlotMotif.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="preview-page" aria-labelledby="page-title">
  <div class="preview-page-copy">
    <h1 class="page-title" id="page-title">
      {title}
    </h1>
    <div class="preview-page-message">
      <slot />
    </div>
  </div>
  <div class="page-motif">
    <PlotMotif />
  </div>
</section>
