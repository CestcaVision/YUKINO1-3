---
interface Props {
  items: { subject: string; media: string[]; capabilities: string[] }[];
}
const { items } = Astro.props;
const fields = [
  {
    name: "subject",
    label: "Subject",
    values: items.map((item) => item.subject),
  },
  {
    name: "media",
    label: "Medium",
    values: items.flatMap((item) => item.media),
  },
  {
    name: "capabilities",
    label: "Capability",
    values: items.flatMap((item) => item.capabilities),
  },
];
---

<evidence-filters>
  {items.length > 0 && (
    <form hidden aria-label="Filter published evidence">
      {fields.map(({ name, label, values }) => (
        <fieldset>
          <legend>{label}</legend>
          <div class="filter-options">
            {["", ...[...new Set(values)].sort()].map((value) => (
              <label class="filter-option">
                <input
                  type="radio"
                  name={name}
                  value={value}
                  checked={value === ""}
                />
                <span>{value || "All"}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <button type="reset">Clear filters</button>
    </form>
  )}
  <p role="status" aria-live="polite" aria-atomic="true" hidden></p>
  <p data-no-matches hidden>
    No published evidence matches these filters.
  </p>
  {items.length === 0 && <p>No published evidence yet.</p>}
  <slot />
</evidence-filters>

<script>
  class EvidenceFilters extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector("form");
      if (!form) return;
      const inputs = Array.from(form.querySelectorAll("input"));
      const items = Array.from(
        this.querySelectorAll<HTMLElement>("[data-evidence-item]"),
      );
      const groups = this.querySelectorAll<HTMLElement>(
        "[data-evidence-group]",
      );
      const status = this.querySelector<HTMLElement>('[role="status"]')!;
      const empty = this.querySelector<HTMLElement>("[data-no-matches]")!;
      const update = () => {
        const selected = inputs.filter((input) => input.checked);
        for (const item of items) {
          const values: Record<string, string | string[]> = JSON.parse(
            item.dataset.evidenceItem!,
          );
          item.hidden = !selected.every(
            ({ name, value }) =>
              !value ||
              (Array.isArray(values[name])
                ? values[name].includes(value)
                : values[name] === value),
          );
        }
        for (const group of groups) {
          group.hidden = !group.querySelector(
            "[data-evidence-item]:not([hidden])",
          );
        }
        const count = items.filter((item) => !item.hidden).length;
        status.textContent = `${count} ${count === 1 ? "result" : "results"}`;
        empty.hidden = count !== 0;
      };
      form.addEventListener("submit", (event) => event.preventDefault());
      form.addEventListener("change", update);
      form.addEventListener("reset", () => {
        inputs.forEach((input) => {
          input.checked = input.defaultChecked;
        });
        update();
      });
      form.hidden = false;
      status.hidden = false;
      update();
    }
  }
  customElements.define("evidence-filters", EvidenceFilters);
</script>

<style>
  evidence-filters {
    display: block;
  }
  form {
    display: grid;
    gap: 1.25rem;
    padding: 2rem 0 1rem;
  }
  form[hidden] {
    display: none;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-option {
    position: relative;
    max-width: 100%;
    cursor: pointer;
  }
  .filter-option input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .filter-option span {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.85rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
    transition:
      background-color 140ms ease,
      border-color 140ms ease;
  }
  .filter-option:hover span {
    background: var(--color-surface);
    border-color: var(--color-muted);
  }
  .filter-option input:checked + span {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .filter-option input:focus-visible + span {
    outline: 0.15rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
  button {
    font: inherit;
    justify-self: start;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-size: 0.8rem;
    min-height: 44px;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  button:hover {
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .filter-option span {
      transition: none;
    }
  }
  [role="status"] {
    color: var(--color-muted);
  }
</style>
